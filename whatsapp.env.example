# FBL WhatsApp Critical Alerts — copy to whatsapp.env (gitignored) for demo.
# CM.py loads whatsapp.env automatically on startup via fbl_whatsapp.py.
# Do NOT commit whatsapp.env. Do NOT put these in frontend / Vite env.

# --- Free Meta sandbox demo (Step 1: Try it out — no payment) ---
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=meta

# From Meta Developer → WhatsApp → API Setup:
WHATSAPP_API_TOKEN=paste_temporary_access_token_here
WHATSAPP_PHONE_NUMBER_ID=paste_phone_number_id_here

# Your phone — must be added as a test recipient in Meta API Setup (max 5).
# E.164 digits only, e.g. 919876543210 or +919876543210
WHATSAPP_RECIPIENT_NUMBER=

WHATSAPP_API_VERSION=v21.0

# --- Log-only demo (no Meta, no phone) — uncomment instead of meta block ---
# WHATSAPP_ENABLED=true
# WHATSAPP_PROVIDER=log
