# Incident Analysis scripts — copy next to CM.py on the Linux collector if you
# override the bundled incident_scripts/ directory.
#
# INCIDENT_SCRIPTS_DIR=/usr/local/fbl/incident
# INCIDENT_OUTPUT_DIR=/tmp
# INCIDENT_ANALYSIS_DEMO=false
#
# Per-utility absolute paths (optional; otherwise <INCIDENT_SCRIPTS_DIR>/<name>):
# ANALYZE_SCRIPT=/usr/local/fbl/incident/Analyze.sh
# HEALTH_ASSESS_SCRIPT=/usr/local/fbl/incident/Health_Assess.sh
# UNIFIED_RCA_SCRIPT=/usr/local/fbl/incident/Unified_RCA.sh
# FORENSIC_SCRIPT=/usr/local/fbl/incident/ForensicV1.sh
# STALL_CAPTURE_SCRIPT=/usr/local/fbl/incident/Stall_Capture_setup.sh
# ANALYZE_STALL_SCRIPT=/usr/local/bin/analyze_stall.sh
# PID500_SCRIPT=/usr/local/fbl/incident/Pid500.sh
#
# Stall capture never enables passwordless sudo. To use non-interactive sudo
# (fails immediately if not already authorized): INCIDENT_STALL_SUDO=false
