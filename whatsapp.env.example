# FBL WhatsApp Critical Alerts — copy values into the Flask host environment.
# Do NOT commit real tokens. Do NOT put these in frontend / Vite env.

WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=log
# Use "log" for safe local testing (messages go to backend logs only).
# Use "meta" for WhatsApp Cloud API (Meta / Facebook).

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
# Recipient in E.164 digits, e.g. 15551234567 (optional leading +)

WHATSAPP_API_VERSION=v21.0
